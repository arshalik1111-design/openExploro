<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><b><%= listing.title%></b></h3>

    <div class="card cols mt-3 listing-card">
      <img
        src="<%= listing.image.url%>"
        class="card-img-top show-img"
        alt="listing-image"
      />
      <div class="card-body mt-3">
        <p class="card-text">
          <%= listing.description%>
          <br />
          Price: &#8377; <%=listing.price.toLocaleString("en-IN")%> / night
          <br />
          Location: <%= listing.location%>
          <br />
          Country: <%= listing.country%>
        </p>
      </div>
    </div>

    <div class="show-btns">
      <a href="/listings/<%=listing._id%>/edit"
        ><button class="update-btn">Edit this listing</button></a
      >
      <form action="/listings/<%=listing._id%>?_method=DELETE" method="post">
        <button class="dlt-btn">Delete this listing</button>
      </form>
    </div>
  </div>
  <br />
  <div class="col-8 offset-2 mt-3 mb-3">
    <hr />
    <form
      action="/listings/<%=listing._id%>/reviews"
      method="post"
      novalidate
      class="needs-validation"
    >
      <label for="range" class="form-label"><h4>Reviews</h4></label>
      <input
        type="range"
        class="form-range"
        min="1"
        max="5"
        value="3"
        id="range"
        name="review[rating]"
      />
      <output for="range" id="rangeValue" aria-hidden="true"></output>

      <div class="mb-3 mt-3">
        <label for="comment"><h4>Comments</h4></label>
        <textarea
          name="review[comment]"
          id="comment"
          rows="5"
          cols="30"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>
      <button type="submit" class="btn btn-dark">Submit</button>
    </form>
    <hr />

    <p><b>All Reviews</b></p>
  

<div class="row">
  
     <%for(review of listing.reviews){ %>
<div class="card col-5 ms-3 mb-3">

   <div class="card-body">
    <h5 class="card-title"></h5>
    <p class="card-text"><%=review.comment%></p>
    <p class="card-text"><%=review.rating%> stars</p>
   </div>
</div>
     <%} %>
</div>

  </div>
</div>

<script src="/js/script.js"></script>
