<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <h1 class="col-6 offset-3">Rukjaa Yaar SignUp karle</h1>
  <div class="col-6 offset-3">
    <form class="needs-validation" action="/signup" method="post" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          id="username"
          class="form-control"
          type="text"
          required
        />
        <div class="valid-feedback">Looks goods</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input
          name="email"
          id="email"
          class="form-control"
          type="email"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          class="form-control"
          type="password"
          required
        />
      </div>
      <button class="btn btn-success">Sign Up</button>
    </form>
  </div>
</div>
